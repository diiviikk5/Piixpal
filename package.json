{
  "name": "piixpal",
  "version": "0.2.0",
  "description": "Tiny pixel creatures that live on your website. Drop-in web components, zero dependencies.",
  "main": "piixpal.js",
  "files": [
    "piixpal.js",
    "piixpal.min.js",
    "dist",
    "wrappers",
    "types"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "docs": "node scripts/docs.mjs"
  },
  "keywords": [
    "pixel",
    "pixel-art",
    "web-components",
    "mascot",
    "sprite",
    "animation",
    "ui",
    "website-pet"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diiviikk5/Piixpal.git"
  },
  "homepage": "https://github.com/diiviikk5/Piixpal#readme",
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "module": "piixpal.js",
  "unpkg": "piixpal.min.js",
  "jsdelivr": "piixpal.min.js",
  "types": "types/piixpal.d.ts",
  "exports": {
    ".": {
      "types": "./types/piixpal.d.ts",
      "default": "./piixpal.js"
    },
    "./min": "./piixpal.min.js",
    "./core": "./dist/core.min.js",
    "./c/*": "./dist/c/*.min.js",
    "./react": "./wrappers/react.jsx",
    "./vue": "./wrappers/vue.js",
    "./svelte": "./wrappers/Piixpal.svelte",
    "./load": "./wrappers/load.js"
  },
  "sideEffects": [
    "piixpal.js",
    "piixpal.min.js",
    "dist/**"
  ],
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
