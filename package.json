{
  "name": "piixpal",
  "version": "0.4.0",
  "description": "Pixel characters that live on your website: drop-in web components with zero dependencies. Pals, sprites and superpowers.",
  "main": "piixpal.js",
  "files": [
    "piixpal.js",
    "piixpal.min.js",
    "dist",
    "wrappers",
    "types"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "docs": "node scripts/docs.mjs",
    "registry": "node scripts/registry.mjs"
  },
  "keywords": [
    "pixel",
    "pixel-art",
    "web-components",
    "mascot",
    "sprite",
    "animation",
    "ui",
    "website-pet",
    "web-component",
    "custom-elements",
    "react",
    "vue",
    "svelte",
    "nextjs",
    "easter-egg",
    "toast",
    "onboarding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diiviikk5/Piixpal.git"
  },
  "homepage": "https://piixpal.vercel.app",
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "module": "piixpal.js",
  "unpkg": "piixpal.min.js",
  "jsdelivr": "piixpal.min.js",
  "types": "types/piixpal.d.ts",
  "exports": {
    ".": {
      "types": "./types/piixpal.d.ts",
      "default": "./piixpal.js"
    },
    "./min": "./piixpal.min.js",
    "./core": "./dist/core.min.js",
    "./c/*": "./dist/c/*.min.js",
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./wrappers/npm/react.js"
    },
    "./vue": "./wrappers/npm/vue.js",
    "./svelte": {
      "svelte": "./wrappers/npm/Piixpal.svelte",
      "default": "./wrappers/npm/Piixpal.svelte"
    },
    "./load": "./wrappers/npm/load.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "piixpal.js",
    "piixpal.min.js",
    "dist/**"
  ],
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3",
    "svelte": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/diiviikk5/Piixpal/issues"
  },
  "author": "diiviikk5"
}
